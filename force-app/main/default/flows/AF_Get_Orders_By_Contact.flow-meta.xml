    <description>Agentforce action: list Orders__c for a Contact matched by Full Name + Email.</description>
    <environments>Default</environments>
    <formulas>
        <name>FirstNameFromFull</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!FullName}, &quot; &quot;), LEFT({!FullName}, FIND(&quot; &quot;, {!FullName}) - 1), {!FullName})</expression>
    </formulas>
    <formulas>
        <name>LastNameFromFull</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!FullName}, &quot; &quot;), TRIM(RIGHT({!FullName}, LEN({!FullName}) - FIND(&quot; &quot;, {!FullName}))), {!FullName})</expression>
    </formulas>
